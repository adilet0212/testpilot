# .env.example

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
DATABASE_URL=postgresql://user:password@host/dbname?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
DEV_SECRET=your_dev_secret_here
GEMINI_API_KEY=your_gemini_api_key_here

# Path to a local Chromium binary for dev (e.g. the one `npx playwright install
# chromium` downloads to your ms-playwright cache). Omit in production —
# @sparticuz/chromium is used instead when this is unset.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Whether this deployment can launch a real browser (scraping, live execution).
# Leave unset to auto-detect: enabled when PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH
# is set (local dev), disabled otherwise (serverless, which can't reliably run
# Chromium). Set to "true" explicitly if you have a working browser runtime in
# production. Values: true | false | unset
LIVE_EXECUTION_ENABLED=

# id of the single public isPublic:true TestRun shown at /sample (no sign-in
# required). Seed it with: pnpm tsx --tsconfig tsconfig.json scripts/seed-sample-run.ts
SAMPLE_RUN_ID=your_seeded_sample_run_id_here